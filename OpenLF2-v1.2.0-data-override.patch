new file mode 100644
index 0000000..70bc439
--- /dev/null
+++ b/dist/stage-data-override.py
@@ -0,0 +1,43 @@
+"""Stage an existing game data ZIP for an OpenLF2 data-override build."""
+
+import argparse
+from pathlib import Path
+from tempfile import TemporaryDirectory
+from zipfile import ZipFile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("archive", type=Path)
+    args = parser.parse_args()
+    destination = Path(__file__).resolve().parents[1] / "scripts" / "data-override"
+    if destination.exists():
+        parser.error(f"move the existing data override aside first: {destination}")
+    staged = set()
+    with ZipFile(args.archive) as archive, TemporaryDirectory(dir=destination.parent) as temp:
+        root = Path(temp)
+        for entry in archive.infolist():
+            path = entry.filename.replace("\\", "/").lower()
+            parts = path.split("/")
+            if entry.is_dir() or Path(path).suffix not in {".dat", ".txt", ".bmp", ".wav", ".lfr", ".wma", ".mp3"}:
+                continue
+            if len(parts) < 2 or parts[0] not in {"data", "sprite", "pics", "bg", "audio", "death"}:
+                continue
+            if any(part in {"", ".", ".."} for part in parts) or any(
+                ord(character) < 32 or ord(character) >= 127 or character == ":" for character in path
+            ):
+                parser.error(f"unsupported resource path: {entry.filename}")
+            if path in staged or entry.file_size > 16 * 1024 * 1024:
+                parser.error(f"duplicate or oversized resource: {entry.filename}")
+            target = root.joinpath(*parts)
+            target.parent.mkdir(parents=True, exist_ok=True)
+            target.write_bytes(archive.read(entry))
+            staged.add(path)
+        if not {"data/data.txt", "data/stage.dat"}.issubset(staged):
+            parser.error("missing data/data.txt or data/stage.dat")
+        root.rename(destination)
+    print(f"Staged {len(staged)} files into {destination}")
+
+
+if __name__ == "__main__":
+    main()
