+
+## Build with a local data override
+
+With an existing game data ZIP that contains top-level asset folders, run
+`python3 dist/stage-data-override.py /path/to/data.zip` before building.
+This stages normalized asset paths under `scripts/data-override`. The Apple
+build includes this folder. The game first reads staged resources and then
+falls back to the supported LF2 v2.0a installer for resources it cannot find.
+The installer is still required. Gameplay rules and EXE resources come from
+the existing OpenLF2 build and supported installer, respectively.
+
+Use `bash dist/build-apple.sh ios-device-arm64` on macOS with the iOS SDK and
+Conan to build the unsigned IPA. Sign the resulting IPA before installing.
diff --git a/dist/stage-data-override.py b/dist/stage-data-override.py
new file mode 100644
index 0000000..ca9d6fb
--- /dev/null
+++ b/dist/stage-data-override.py
@@ -0,0 +1,74 @@
+"""Stage an existing game data ZIP for an OpenLF2 data-override build."""
+
+import argparse
+import re
+from pathlib import Path
+from tempfile import TemporaryDirectory
+from zipfile import ZipFile
+
+
+def write_fighter_names(root):
+    section = (root / "data/data.txt").read_bytes().split(b"<object>", 1)[1].split(b"<object_end>", 1)[0]
+    key = b"SiuHungIsAGoodBearBecauseHeIsVeryGood"
+    names = {}
+    for raw_path in re.findall(rb"type:[ \t]*0[ \t]+file:[ \t]*(\S+)", section):
+        path = raw_path.decode("ascii").replace("\\", "/").lower()
+        if any(part in {"", ".", ".."} for part in path.split("/")) or ":" in path:
+            raise ValueError(f"unsupported fighter path: {path}")
+        data = (root / path).read_bytes()
+        if path.endswith(".dat"):
+            data = bytes((data[i] - key[i % len(key)]) % 256 for i in range(123, len(data)))
+        header = re.search(rb"<bmp_begin>(.*?)<bmp_end>", data, re.S)
+        name = re.search(rb"name:[ \t]*(\S+)", header[1]) if header else None
+        if name and not name[1].isascii():
+            names[path] = name[1].decode("cp950")
+    (root / "data/override-fighter-names.txt").write_text(
+        "".join(f"{path}\t{name}\n" for path, name in sorted(names.items())), encoding="utf-8"
+    )
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("archive", type=Path)
+    args = parser.parse_args()
+    destination = Path(__file__).resolve().parents[1] / "scripts" / "data-override"
+    if destination.exists():
+        parser.error(f"move the existing data override aside first: {destination}")
+    staged = set()
+    with ZipFile(args.archive) as archive, TemporaryDirectory(dir=destination.parent) as temp:
+        root = Path(temp)
+        for entry in archive.infolist():
+            path = entry.filename.replace("\\", "/").lower()
+            parts = path.split("/")
+            if entry.is_dir() or Path(path).suffix not in {".dat", ".txt", ".bmp", ".wav", ".lfr", ".wma", ".mp3"}:
+                continue
+            if len(parts) < 2 or parts[0] not in {"data", "sprite", "pics", "bg", "audio", "death"}:
+                continue
+            if any(part in {"", ".", ".."} for part in parts) or any(
+                ord(character) < 32 or ord(character) >= 127 or character == ":" for character in path
+            ):
+                parser.error(f"unsupported resource path: {entry.filename}")
+            if path in staged or entry.file_size > 16 * 1024 * 1024:
+                parser.error(f"duplicate or oversized resource: {entry.filename}")
+            target = root.joinpath(*parts)
+            target.parent.mkdir(parents=True, exist_ok=True)
+            data = archive.read(entry)
+            if path == "data/data.txt":
+                # Older mod catalogs can label a type-2 object's path "fire:"
+                # instead of "file:". OpenLF2's catalog requires "file:".
+                data = re.sub(
+                    rb"(?m)^([ \t]*id:[ \t]*\d+[ \t]+type:[ \t]*2[ \t]+)fire:(?=[ \t])",
+                    rb"\g<1>file:",
+                    data,
+                )
+            target.write_bytes(data)
+            staged.add(path)
+        if not {"data/data.txt", "data/stage.dat"}.issubset(staged):
+            parser.error("missing data/data.txt or data/stage.dat")
+        write_fighter_names(root)
+        root.rename(destination)
+    print(f"Staged {len(staged)} files into {destination}")
+
+
+if __name__ == "__main__":
+    main()
