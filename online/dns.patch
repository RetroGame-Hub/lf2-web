+struct ConnectAddress {
+    sockaddr_storage address{};
+    SocketLength length{};
+};
+
+Result<ConnectAddress> resolve_peer(const std::string& host, std::uint16_t port) {
+    addrinfo hints{};
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+    hints.ai_protocol = IPPROTO_TCP;
+    hints.ai_flags = AI_NUMERICSERV;
+    addrinfo* records = nullptr;
+    const auto service = std::to_string(port);
+    if (getaddrinfo(host.c_str(), service.c_str(), &hints, &records) != 0) {
+        return fail(ErrorCode::io, "Could not resolve matchmaking server");
+    }
+    const std::unique_ptr<addrinfo, decltype(&freeaddrinfo)> results(records, freeaddrinfo);
+    for (auto* entry = records; entry; entry = entry->ai_next) {
+        ConnectAddress target{};
+        if ((entry->ai_family != AF_INET && entry->ai_family != AF_INET6) ||
+            entry->ai_addrlen > sizeof(target.address)) continue;
+        std::memcpy(&target.address, entry->ai_addr, entry->ai_addrlen);
+        target.length = static_cast<SocketLength>(entry->ai_addrlen);
+        return target;
+    }
+    return fail(ErrorCode::io, "No address found for matchmaking server");
+}
